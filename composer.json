{
    "name": "sfambach/wp-tax-stock",
    "description": "Taxmod Stock — stock keeping on top of the Taxonomy Modeller.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "TaxmodStock\\Core\\": "src/Core/",
            "TaxmodStock\\WordPress\\": "src/WordPress/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload-dev": {
        "psr-4": {
            "TaxmodStock\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
